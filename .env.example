# Edition / archive
# editionDate uses this IANA timezone (independent of US marketDate).
REPORT_TZ=Asia/Taipei
REPORT_LOCALE=zh
REPORT_OUTPUT_DIR=daily_reports
# Optional public pages URL (not required for the private email workflow).
REPORT_BASE_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPOSITORY

# Modules (opt-in / safe defaults)
# Comma list overrides individual flags when set: market,tech-news
# BRIEF_MODULES=market,tech-news
MARKET_MODULE_ENABLED=true
# Tech news is off by default so market-only production stays safe without AI config.
TECH_NEWS_ENABLED=false
TECH_NEWS_LIMIT=5
TECH_NEWS_WINDOW_HOURS=30

# LLM for the oversized local site pipeline (scripts/daily.ts) — not required
# for the production email. Email tech summaries use GitHub Models when
# GITHUB_TOKEN is present; otherwise factual title/excerpt fallback.
LLM_BACKEND=openai
LLM_MODEL=
OPENAI_API_KEY=

# GitHub Models (used by market commentary + optional tech summaries in Actions)
# GITHUB_TOKEN is provided automatically in GitHub Actions.
# GITHUB_MODELS_MODEL=openai/gpt-4.1

# Gmail SMTP. Use a Google application password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPORT_RECIPIENT=
# Optional From display name (default: 个人每日简报)
# MAIL_FROM_NAME=个人每日简报
