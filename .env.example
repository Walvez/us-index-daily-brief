# Report
REPORT_TZ=Asia/Shanghai
REPORT_LOCALE=zh
REPORT_OUTPUT_DIR=daily_reports
REPORT_BASE_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPOSITORY

# LLM. If unavailable, the brief falls back to deterministic Chinese text.
LLM_BACKEND=openai
LLM_MODEL=
OPENAI_API_KEY=

# Gmail SMTP. Use a Google application password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPORT_RECIPIENT=
